# =====================================================
# .ENV.EXAMPLE — Contoh konfigurasi sistem Rotama Jaya
# =====================================================
# Cara pakai:
#   1. Salin file ini menjadi ".env" (di folder yang sama)
#   2. Isi nilainya sesuai server/komputer masing-masing
#   3. JANGAN pernah unggah file ".env" (yang sudah diisi) ke Git/publik —
#      file ini berisi kata sandi database.
#
# Kalau file .env tidak ada sama sekali, sistem akan tetap jalan memakai
# nilai bawaan (cocok untuk XAMPP/Laragon di komputer lokal).

# development -> tampilkan detail error (untuk debugging saat pengerjaan)
# production  -> sembunyikan detail error dari pengunjung, catat ke log server saja
APP_ENV=development

# ---- Database MySQL ----
DB_HOST=localhost
DB_NAME=rotama_jaya
DB_USER=root
DB_PASSWORD=

# ---- Layanan Python Flask (mesin rekomendasi) ----
# Di VPS, layanan ini berjalan di komputer/server yang sama dan hanya
# dipanggil dari PHP (server-to-server), jadi cukup 127.0.0.1.
ALAMAT_LAYANAN_PYTHON=http://127.0.0.1:5000

# ---- PHP CLI untuk pemrosesan desain background ----
# Pada PHP-FPM, PHP_BINARY dapat menunjuk ke php-fpm, bukan PHP CLI.
# Gunakan "php" untuk PATH lokal; di VPS Linux bisa diubah menjadi /usr/bin/php.
PHP_CLI_BIN=php
